name: Build APK

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    
    env:
      GRADLE_OPTS: "-Dorg.gradle.jvmargs=-Xmx4096m -XX:MaxMetaspaceSize=1024m"
      JAVA_HOME: /opt/hostedtoolcache/Java_Temurin-Hotspot_jdk/17.0.20-1/x64
    
    steps:
      - name: Checkout
        uses: actions/checkout@v4
      
      - name: Setup Java 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'
      
      - name: Setup Flutter
        uses: subosito/flutter-action@v2
        with:
          flutter-version: '3.38.0'
          channel: 'stable'
      
      - name: Download project ZIP
        run: |
          mkdir -p project_raw
          cd project_raw
          curl -L -o rioomd.zip "${{ env.ZIP_URL }}"
          unzip -o rioomd.zip
          ls -la
      
      - name: Flutter Clean
        run: |
          cd project_raw/DarkVerse
          flutter clean
      
      - name: Flutter Pub Get
        run: |
          cd project_raw/DarkVerse
          flutter pub get
      
      - name: Fix gradle.properties
        run: |
          cd project_raw/DarkVerse/android
          cat >> gradle.properties << 'EOF'
          org.gradle.jvmargs=-Xmx4096m -XX:MaxMetaspaceSize=1024m
          org.gradle.daemon=true
          org.gradle.parallel=true
          org.gradle.caching=true
          android.useAndroidX=true
          android.enableJetifier=true
          EOF
      
      - name: Build APK
        run: |
          cd project_raw/DarkVerse
          flutter build apk --release --no-shrink 2>&1 | tee build.log
      
      - name: Show build log
        if: always()
        run: |
          if [ -f project_raw/DarkVerse/build.log ]; then
            cat project_raw/DarkVerse/build.log
          fi
      
      - name: Upload APK
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: apk-release
          path: project_raw/DarkVerse/build/app/outputs/flutter-apk/*.apk
      
      - name: Upload build log
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: build-log
          path: project_raw/DarkVerse/build.log
          if-no-files-found: ignore
